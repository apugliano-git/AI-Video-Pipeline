# Application
APP_NAME=AI Video Clipper
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Redis (Celery broker + job status)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Local storage paths (relative to project root)
STORAGE_ROOT=storage
DOWNLOADS_DIR=storage/downloads
TEMP_DIR=storage/temp

# yt-dlp
YTDLP_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best
YTDLP_AUDIO_FORMAT=wav

# Whisper (faster-whisper)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave blank to auto-detect language, or set e.g. WHISPER_LANGUAGE=es
WHISPER_LANGUAGE=

# LLM Provider — set to "groq" or "gemini"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (used when LLM_PROVIDER=gemini)
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase Storage (optional — leave empty to use local filesystem fallback)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=clips
